{
    "name": "chronhub/storm-stream",
    "description": "Stream and StreamName — the validated, immutable appended unit of the Storm event store",
    "type": "library",
    "license": "MIT",
    "keywords": ["ddd", "event-sourcing", "stream", "cqrs"],
    "require": {
        "php": ">=8.5",
        "chronhub/storm-contracts": "self.version",
        "chronhub/storm-message": "self.version",
        "chronhub/storm-support": "self.version"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4.0",
        "phpstan/phpstan": "^2.2.16"
    },
    "autoload": {
        "psr-4": {
            "Storm\\Stream\\": "./"
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Storm\\Stream\\Tests\\": "Tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
